# Copy to deer.env and fill in. Everything here is optional:
# PayPal keys can also be entered in Admin > Plans instead.
DEER_HOST=127.0.0.1
DEER_PORT=8000
# DEER_DATA=/path/to/deer_data
# DEER_TRAIN_MODE=thread     # use if training won't start on your device
# DEER_MAX_JOBS=2            # models that may train at the same time
# DEER_BUSY_SHARE=0.5        # hold a 2nd job back if other work uses more than this share of the cores
# DEER_MIN_FREE_MB=1500      # ...or if less memory than this is free
# PAYPAL_MODE=sandbox        # sandbox or live
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# DEER_ALLOWED_ORIGINS=https://yourname.github.io   # sites (like GitHub Pages) allowed to use this server
